import Section_5_ComputationalModel.A_PolycyclicModel
import Lean.Elab.Tactic.Omega
import Mathlib.Tactic.IntervalCases
import Mathlib.Data.Fintype.Defs

/-!
# Fuel lemmas for the polycyclic collector

The collector `collectWord` in `A_PolycyclicModel` is parameterized by
a fuel bound: it stops early (returning the exponent list unchanged)
when the fuel runs out. This file proves that the fuel does not matter
once it is large enough: `collectWord` is constant in the fuel above a
*computable* bound `wordBound w`, defined from a per-generator step
bound `stepsAtom` (checked against the conjugation data: the bound for
the suffix word generated by inserting generator `j` is exactly
`stepsAtom j - 1`). From this we get the append lemma
(`collectWord_append`) that makes `actWord` a homomorphism on words,
hence a homomorphism out of `CounterexampleGroup`.

The step table `stepsAtom = [701, 147, 73, 37, 17, 7, 3, 1]` is the
solution of the recurrence
`stepsAtom j = 1 + Σ_{k>j} (R[k]-1) · Σ_{a ∈ conjWord k j} (stepsAtom a.1 + 1) + (stepsAtom 7 + 1 if j ∈ {3,4})`,
checked in Python against the conjugation tables; the Lean proofs
below verify the needed inequalities by finite computation.
-/

namespace SemiabelianNonMonomial

/-- Step bound for collecting one atom of generator `g` (plus its
generated suffix words), from any valid exponent list. -/
def stepsAtom (g : Nat) : Nat :=
  match g with
  | 0 => 701
  | 1 => 147
  | 2 => 73
  | 3 => 37
  | 4 => 17
  | 5 => 7
  | 6 => 3
  | _ => 1

/-- Step bound for one atom, including the inverse-expansion cost. -/
def atomBound : Nat × Bool → Nat
  | (g, false) => stepsAtom g
  | (g, true) =>
      (pcRange g - 1) * (stepsAtom g + 1) + (if g = 3 ∨ g = 4 then 4 else 0) + 1

/-- Step bound for a word: sum of per-atom bounds plus one per atom. -/
def wordBound (w : List (Nat × Bool)) : Nat :=
  (w.map (fun a => atomBound a + 1)).sum

theorem wordBound_nil : wordBound [] = 0 := rfl

theorem wordBound_cons (a : Nat × Bool) (w : List (Nat × Bool)) :
    wordBound (a :: w) = atomBound a + 1 + wordBound w := by
  simp [wordBound]

theorem wordBound_append (w₁ w₂ : List (Nat × Bool)) :
    wordBound (w₁ ++ w₂) = wordBound w₁ + wordBound w₂ := by
  simp [wordBound, List.map_append, List.sum_append]

/-- Every atom of a conjugation word has index strictly above the
conjugated generator's index. The finite part is checked by `decide`
over `Fin 8`; out-of-range indices give the empty word. -/
theorem conjWord_atom_gt {k j : Nat} {a : Nat × Bool} (ha : a ∈ conjWord k j) :
    j < a.1 := by
  rcases Nat.lt_or_ge k 8 with hk | hk <;> rcases Nat.lt_or_ge j 8 with hj | hj
  · have hfin : ∀ k j : Fin 8, ∀ a ∈ conjWord k.1 j.1, j.1 < a.1 := by decide
    exact hfin ⟨k, hk⟩ ⟨j, hj⟩ a ha
  · obtain ⟨m, rfl⟩ : ∃ m, j = m + 8 := ⟨j - 8, by omega⟩
    have h0 : conjWord k (m + 8) = [] := by cases k <;> simp [conjWord]
    rw [h0] at ha
    exact absurd ha (by simp)
  · obtain ⟨m, rfl⟩ : ∃ m, k = m + 8 := ⟨k - 8, by omega⟩
    have h0 : conjWord (m + 8) j = [] := rfl
    rw [h0] at ha
    exact absurd ha (by simp)
  · obtain ⟨m, rfl⟩ : ∃ m, k = m + 8 := ⟨k - 8, by omega⟩
    have h0 : conjWord (m + 8) j = [] := rfl
    rw [h0] at ha
    exact absurd ha (by simp)

theorem stepsAtom_pos (g : Nat) : 0 < stepsAtom g := by
  rcases Nat.lt_or_ge g 8 with hg | hg
  · interval_cases g <;> simp [stepsAtom]
  · obtain ⟨m, rfl⟩ : ∃ m, g = m + 8 := ⟨g - 8, by omega⟩
    show 0 < 1
    exact Nat.zero_lt_one

/-- The step bound is antitone in the generator index (larger index
means fewer generators above it). -/
theorem stepsAtom_antitone {g g' : Nat} (h : g ≤ g') : stepsAtom g' ≤ stepsAtom g := by
  rcases Nat.lt_or_ge g' 8 with hg' | hg'
  · rcases Nat.lt_or_ge g 8 with hg | hg
    · have hfin : ∀ g g' : Fin 8, g.1 ≤ g'.1 → stepsAtom g'.1 ≤ stepsAtom g.1 := by decide
      exact hfin ⟨g, hg⟩ ⟨g', hg'⟩ h
    · omega
  · obtain ⟨m, rfl⟩ : ∃ m, g' = m + 8 := ⟨g' - 8, by omega⟩
    have h1 : stepsAtom (m + 8) = 1 := rfl
    rw [h1]
    exact stepsAtom_pos g

theorem posBound_atom_gt {k j : Nat} {a : Nat × Bool} (ha : a ∈ conjWord k j) :
    atomBound a + 1 ≤ stepsAtom j := by
  have hgt := conjWord_atom_gt ha
  rcases Nat.lt_or_ge j 8 with hj | hj
  · have hfin : ∀ k j : Fin 8, ∀ a ∈ conjWord k.1 j.1, atomBound a + 1 ≤ stepsAtom j.1 := by decide
    rcases Nat.lt_or_ge k 8 with hk | hk
    · exact hfin ⟨k, hk⟩ ⟨j, hj⟩ a ha
    · obtain ⟨m, rfl⟩ : ∃ m, k = m + 8 := ⟨k - 8, by omega⟩
      have h0 : conjWord (m + 8) j = [] := rfl
      rw [h0] at ha
      exact absurd ha (by simp)
  · obtain ⟨m, rfl⟩ : ∃ m, j = m + 8 := ⟨j - 8, by omega⟩
    have h0 : conjWord k (m + 8) = [] := by cases k <;> simp [conjWord]
    rw [h0] at ha
    exact absurd ha (by simp)

/-- Valid exponent lists: length 8, every exponent below its relative order. -/
def ValidExps (e : List Nat) : Prop :=
  e.length = 8 ∧ ∀ k < 8, getExp e k < pcRange k

theorem valid_zeroExps : ValidExps zeroExps := by
  refine ⟨rfl, fun k hk => ?_⟩
  interval_cases k <;> decide

/-- The suffix word generated by inserting generator `j`, as a
standalone word (the same construction as inside `insertOne`). -/
def suffixWordOf (e : List Nat) (j : Nat) : List (Nat × Bool) :=
  (if getExp e j + 1 = pcRange j then carryWord j else []) ++
    (List.range 8).foldl (fun w k =>
      if j < k then w ++ (List.replicate (getExp e k) (conjWord k j)).flatten
      else w) []

theorem wordBound_replicate_flatten (n : Nat) (w : List (Nat × Bool)) :
    wordBound ((List.replicate n w).flatten) = n * wordBound w := by
  induction n with
  | zero => simp [wordBound]
  | succ n ih =>
    rw [List.replicate_succ, List.flatten_cons, wordBound_append, ih, Nat.succ_mul]
    omega

theorem getExp_setExp (e : List Nat) (i v k : Nat) (hi : i < e.length) :
    getExp (setExp e i v) k = if k = i then v else getExp e k := by
  simp only [getExp, setExp, List.getD_eq_getElem?_getD]
  by_cases h : k = i
  · subst h
    simp [List.getElem?_set_self hi]
  · simp [List.getElem?_set_ne (Ne.symm h), h]

theorem getExp_setExp_ne {e : List Nat} {i v k : Nat} (h : k ≠ i) :
    getExp (setExp e i v) k = getExp e k := by
  simp only [getExp, setExp, List.getD_eq_getElem?_getD, List.getElem?_set_ne (Ne.symm h)]

/-- The final merge step of `insertOne`, factored out: bump position `j`
and overwrite the positions above `j` with the collected suffix. -/
def mergeExps (e suffix : List Nat) (j : Nat) : List Nat :=
  (List.range 8).foldl (fun v k => if j < k then setExp v k (getExp suffix k) else v)
    (setExp e j ((getExp e j + 1) % pcRange j))

theorem insertOne_eq (collect : List Nat → List (Nat × Bool) → List Nat)
    (e : List Nat) (j : Nat) :
    insertOne collect e j = mergeExps e (collect zeroExps (suffixWordOf e j)) j := by
  unfold insertOne suffixWordOf mergeExps
  by_cases hc : getExp e j + 1 = pcRange j <;> simp [hc]

theorem valid_foldl {F : List Nat → Nat → List Nat} {l : List Nat} {v : List Nat}
    (hF : ∀ v k, k < 8 → ValidExps v → ValidExps (F v k))
    (hl : ∀ k ∈ l, k < 8) (hv : ValidExps v) :
    ValidExps (l.foldl F v) := by
  induction l generalizing v with
  | nil => simpa using hv
  | cons a as ih =>
    rw [List.foldl_cons]
    exact ih (fun k hk => hl k (List.mem_cons_of_mem a hk))
      (hF v a (hl a (by simp)) hv)

theorem valid_mergeExps {e suffix : List Nat} (he : ValidExps e)
    (hs : ValidExps suffix) (j : Nat) :
    ValidExps (mergeExps e suffix j) := by
  apply valid_foldl _ (v := setExp e j ((getExp e j + 1) % pcRange j))
    (fun k hk => List.mem_range.mp hk) _
  · intro v k hk hv
    by_cases hjk : j < k
    · rw [if_pos hjk]
      refine ⟨?_, fun k' hk' => ?_⟩
      · simp only [setExp, List.length_set]
        exact hv.1
      · by_cases h : k' = k
        · rw [getExp_setExp _ _ _ _ (by rw [hv.1]; exact hk), if_pos h, h]
          exact hs.2 k hk
        · rw [getExp_setExp_ne h]
          exact hv.2 k' hk'
    · rw [if_neg hjk]
      exact hv
  · refine ⟨?_, fun k' hk' => ?_⟩
    · simp only [setExp, List.length_set]
      exact he.1
    · by_cases h : k' = j
      · have hj8 : j < 8 := h ▸ hk'
        rw [getExp_setExp _ _ _ _ (by rw [he.1]; exact hj8), if_pos h, h]
        exact Nat.mod_lt _ (by interval_cases j <;> decide)
      · rw [getExp_setExp_ne h]
        exact he.2 k' hk'

/-- Atoms below 8: all words we ever collect have generator indices in `Fin 8`. -/
def WordAtomsLt8 (w : List (Nat × Bool)) : Prop :=
  ∀ a ∈ w, a.1 < 8

theorem WordAtomsLt8_conjWord {k j : Nat} : WordAtomsLt8 (conjWord k j) := by
  intro a ha
  rcases Nat.lt_or_ge k 8 with hk | hk <;> rcases Nat.lt_or_ge j 8 with hj | hj
  · have hfin : ∀ k j : Fin 8, ∀ a ∈ conjWord k.1 j.1, a.1 < 8 := by decide
    exact hfin ⟨k, hk⟩ ⟨j, hj⟩ a ha
  · obtain ⟨m, rfl⟩ : ∃ m, j = m + 8 := ⟨j - 8, by omega⟩
    cases k <;> simp [conjWord] at ha
  · obtain ⟨m, rfl⟩ : ∃ m, k = m + 8 := ⟨k - 8, by omega⟩
    cases j <;> simp [conjWord] at ha
  · obtain ⟨m, rfl⟩ : ∃ m, k = m + 8 := ⟨k - 8, by omega⟩
    cases j <;> simp [conjWord] at ha

theorem WordAtomsLt8_carryWord (j : Nat) : WordAtomsLt8 (carryWord j) := by
  intro a ha
  rcases Nat.lt_or_ge j 8 with hj | hj
  · have hfin : ∀ j : Fin 8, ∀ a ∈ carryWord j.1, a.1 < 8 := by decide
    exact hfin ⟨j, hj⟩ a ha
  · obtain ⟨m, rfl⟩ : ∃ m, j = m + 8 := ⟨j - 8, by omega⟩
    have h0 : carryWord (m + 8) = [] := by cases m <;> rfl
    rw [h0] at ha
    exact absurd ha (by simp)

theorem WordAtomsLt8_invAtomWord {g : Nat} (hg : g < 8) :
    WordAtomsLt8 (invAtomWord g) := by
  intro a ha
  have hfin : ∀ g : Fin 8, ∀ a ∈ invAtomWord g.1, a.1 < 8 := by decide
  exact hfin ⟨g, hg⟩ a ha

theorem wordBound_foldl_le {l : List Nat} {acc : List (Nat × Bool)}
    {e : List Nat} {j : Nat} (hvalid : ValidExps e) :
    wordBound (l.foldl (fun w k =>
      if j < k then w ++ (List.replicate (getExp e k) (conjWord k j)).flatten
      else w) acc) ≤
      wordBound acc +
        (l.map (fun k => if j < k then (pcRange k - 1) * wordBound (conjWord k j)
          else 0)).sum := by
  induction l generalizing acc with
  | nil => simp
  | cons k ks ih =>
    rw [List.foldl_cons]
    have hstep : wordBound (if j < k then
        acc ++ (List.replicate (getExp e k) (conjWord k j)).flatten else acc) ≤
        wordBound acc +
          (if j < k then (pcRange k - 1) * wordBound (conjWord k j) else 0) := by
      by_cases hjk : j < k
      · have e1 : (if j < k then
            acc ++ (List.replicate (getExp e k) (conjWord k j)).flatten else acc) =
            acc ++ (List.replicate (getExp e k) (conjWord k j)).flatten := if_pos hjk
        have e2 : (if j < k then (pcRange k - 1) * wordBound (conjWord k j) else 0) =
            (pcRange k - 1) * wordBound (conjWord k j) := if_pos hjk
        rw [e1, e2, wordBound_append, wordBound_replicate_flatten]
        by_cases hk : k < 8
        · have hge : getExp e k ≤ pcRange k - 1 := by
            have h1 := hvalid.2 k hk
            have h2 : 1 ≤ pcRange k := by interval_cases k <;> decide
            omega
          exact Nat.add_le_add_left (Nat.mul_le_mul_right _ hge) _
        · have h0 : wordBound (conjWord k j) = 0 := by
            have hc : conjWord k j = [] := by
              obtain ⟨m, rfl⟩ : ∃ m, k = m + 8 := ⟨k - 8, by omega⟩
              cases j <;> simp [conjWord]
            rw [hc]; simp [wordBound]
          rw [h0]
          simp
      · have e1 : (if j < k then
            acc ++ (List.replicate (getExp e k) (conjWord k j)).flatten else acc) = acc :=
          if_neg hjk
        have e2 : (if j < k then (pcRange k - 1) * wordBound (conjWord k j) else 0) = 0 :=
          if_neg hjk
        rw [e1, e2]
        omega
    have hsum : ((k :: ks).map (fun k => if j < k then
        (pcRange k - 1) * wordBound (conjWord k j) else 0)).sum =
        (if j < k then (pcRange k - 1) * wordBound (conjWord k j) else 0) +
        (ks.map (fun k => if j < k then (pcRange k - 1) * wordBound (conjWord k j)
          else 0)).sum := by simp
    rw [hsum]
    exact le_trans (ih (acc := if j < k then
      acc ++ (List.replicate (getExp e k) (conjWord k j)).flatten else acc)) (by omega)

theorem carryWord_bound (j : Nat) :
    wordBound (carryWord j) ≤ (if j = 3 ∨ j = 4 then 2 else 0) := by
  rcases Nat.lt_or_ge j 8 with hj | hj
  · interval_cases j <;> decide
  · obtain ⟨m, rfl⟩ : ∃ m, j = m + 8 := ⟨j - 8, by omega⟩
    have h0 : carryWord (m + 8) = [] := by cases m <;> rfl
    rw [h0]; simp [wordBound]

theorem rangeSum_bound (j : Nat) (hj : j < 8) :
    ((List.range 8).map (fun k => if j < k then
      (pcRange k - 1) * wordBound (conjWord k j) else 0)).sum +
      (if j = 3 ∨ j = 4 then 2 else 0) ≤ stepsAtom j - 1 := by
  interval_cases j <;> decide

theorem wordBound_suffixWordOf {e : List Nat} (hvalid : ValidExps e) (j : Nat) :
    wordBound (suffixWordOf e j) ≤ stepsAtom j - 1 := by
  have hfold := wordBound_foldl_le (l := List.range 8) (acc := [])
    (e := e) (j := j) hvalid
  simp only [wordBound_nil, zero_add] at hfold
  have hcarry : wordBound (if getExp e j + 1 = pcRange j then carryWord j else []) ≤
      (if j = 3 ∨ j = 4 then 2 else 0) := by
    by_cases hc : getExp e j + 1 = pcRange j
    · have e1 : (if getExp e j + 1 = pcRange j then carryWord j else []) = carryWord j :=
        if_pos hc
      rw [e1]
      exact carryWord_bound j
    · have e1 : (if getExp e j + 1 = pcRange j then carryWord j else []) = [] := if_neg hc
      rw [e1]; simp [wordBound]
  rcases Nat.lt_or_ge j 8 with hj | hj
  · unfold suffixWordOf
    rw [wordBound_append]
    have hsum := rangeSum_bound j hj
    omega
  · obtain ⟨m, rfl⟩ : ∃ m, j = m + 8 := ⟨j - 8, by omega⟩
    have h0 : carryWord (m + 8) = [] := by cases m <;> rfl
    have h1 : stepsAtom (m + 8) = 1 := rfl
    rw [h1]
    have hfold0 : wordBound ((List.range 8).foldl (fun w k =>
        if m + 8 < k then w ++ (List.replicate (getExp e k) (conjWord k (m + 8))).flatten
        else w) []) = 0 := by
      have hsteps : ∀ (l : List Nat) (acc : List (Nat × Bool)),
          (∀ k ∈ l, ¬ (m + 8 < k)) →
          l.foldl (fun w k => if m + 8 < k then
            w ++ (List.replicate (getExp e k) (conjWord k (m + 8))).flatten else w) acc = acc := by
        intro l
        induction l with
        | nil => intro acc _; rfl
        | cons k ks ih =>
          intro acc h
          rw [List.foldl_cons]
          have hk : ¬ (m + 8 < k) := h k (by simp)
          rw [if_neg hk]
          exact ih acc (fun k' hk' => h k' (List.mem_cons_of_mem k hk'))
      rw [hsteps (List.range 8) [] (by intro k hk; simp [List.mem_range] at hk; omega)]
      simp [wordBound]
    have hc0 : wordBound (if getExp e (m + 8) + 1 = pcRange (m + 8) then carryWord (m + 8)
        else []) = 0 := by
      by_cases hc : getExp e (m + 8) + 1 = pcRange (m + 8)
      · rw [if_pos hc, h0]; simp [wordBound]
      · rw [if_neg hc]; simp [wordBound]
    have hzero : wordBound (suffixWordOf e (m + 8)) = 0 := by
      calc wordBound (suffixWordOf e (m + 8))
          = wordBound (if getExp e (m + 8) + 1 = pcRange (m + 8) then carryWord (m + 8)
              else []) + wordBound ((List.range 8).foldl (fun w k =>
              if m + 8 < k then w ++ (List.replicate (getExp e k) (conjWord k (m + 8))).flatten
              else w) []) := by rw [suffixWordOf, wordBound_append]
        _ = 0 + 0 := by rw [hc0, hfold0]
        _ = 0 := by simp
    omega

theorem wordBound_invAtomWord {g : Nat} (hg : g < 8) :
    wordBound (invAtomWord g) ≤ atomBound (g, true) - 1 := by
  interval_cases g <;> simp [invAtomWord, wordBound, atomBound, stepsAtom, pcRange] <;> omega

theorem WordAtomsLt8_suffixWordOf (e : List Nat) (j : Nat) :
    WordAtomsLt8 (suffixWordOf e j) := by
  intro a ha
  unfold suffixWordOf at ha
  rw [List.mem_append] at ha
  cases ha with
  | inl ha =>
    by_cases hc : getExp e j + 1 = pcRange j
    · rw [if_pos hc] at ha
      exact WordAtomsLt8_carryWord j a ha
    · rw [if_neg hc] at ha
      exact absurd ha (by simp)
  | inr ha =>
    have key : ∀ (l : List Nat) (acc : List (Nat × Bool)),
        (∀ a ∈ acc, a.1 < 8) →
        (∀ k ∈ l, ∀ a ∈ (if j < k then
          (List.replicate (getExp e k) (conjWord k j)).flatten else []), a.1 < 8) →
        ∀ a ∈ l.foldl (fun w k => if j < k then
          w ++ (List.replicate (getExp e k) (conjWord k j)).flatten else w) acc,
          a.1 < 8 := by
      intro l
      induction l with
      | nil => intro acc hacc _ a ha; simpa using hacc a ha
      | cons k ks ih =>
        intro acc hacc hks a ha
        rw [List.foldl_cons] at ha
        refine ih _ ?_ ?_ a ha
        · intro a' ha'
          by_cases hjk : j < k
          · rw [if_pos hjk, List.mem_append] at ha'
            cases ha' with
            | inl h => exact hacc a' h
            | inr h =>
              rw [List.mem_flatten] at h
              obtain ⟨l', hl', ha'l'⟩ := h
              rw [List.mem_replicate] at hl'
              obtain ⟨_, rfl⟩ := hl'
              exact WordAtomsLt8_conjWord a' ha'l'
          · rw [if_neg hjk] at ha'
            exact hacc a' ha'
        · intro k' hk' a' ha'
          exact hks k' (List.mem_cons_of_mem k hk') a' ha'
    exact key (List.range 8) [] (by simp) (fun k _ a ha => by
      by_cases hjk : j < k
      · rw [if_pos hjk] at ha
        rw [List.mem_flatten] at ha
        obtain ⟨l', hl', ha'l'⟩ := ha
        rw [List.mem_replicate] at hl'
        obtain ⟨_, rfl⟩ := hl'
        exact WordAtomsLt8_conjWord a ha'l'
      · rw [if_neg hjk] at ha
        exact absurd ha (by simp)) a ha


/-- Validity is preserved by the collector, at any fuel. -/
theorem collectWord_valid : ∀ (fuel : Nat) (w : List (Nat × Bool)) (e : List Nat),
    ValidExps e → WordAtomsLt8 w → ValidExps (collectWord fuel e w) := by
  intro fuel
  induction fuel with
  | zero =>
    intro w e hvalid _
    cases w with
    | nil => exact hvalid
    | cons a as => exact hvalid
  | succ fuel ih =>
    intro w e hvalid hats
    cases w with
    | nil => exact hvalid
    | cons a as =>
      have hstep : collectWord (fuel + 1) e (a :: as) =
          collectWord fuel (insertAtom (collectWord fuel) e a) as := rfl
      rw [hstep]
      apply ih as _ _ (fun a' ha' => hats a' (by simp [ha']))
      have hvalid_insert : ValidExps (insertAtom (collectWord fuel) e a) := by
        obtain ⟨g, inv⟩ := a
        have hg : g < 8 := hats (g, inv) (by simp)
        cases inv with
        | false =>
          show ValidExps (insertOne (collectWord fuel) e g)
          rw [insertOne_eq]
          exact valid_mergeExps hvalid
            (ih (suffixWordOf e g) zeroExps valid_zeroExps
              (WordAtomsLt8_suffixWordOf e g)) g
        | true =>
          show ValidExps (collectWord fuel e (invAtomWord g))
          exact ih (invAtomWord g) e hvalid (WordAtomsLt8_invAtomWord hg)
      exact hvalid_insert

theorem valid_insertAtom (fuel : Nat) (e : List Nat) (a : Nat × Bool)
    (hvalid : ValidExps e) (ha : a.1 < 8) :
    ValidExps (insertAtom (collectWord fuel) e a) := by
  obtain ⟨g, inv⟩ := a
  cases inv with
  | false =>
    show ValidExps (insertOne (collectWord fuel) e g)
    rw [insertOne_eq]
    exact valid_mergeExps hvalid
      (collectWord_valid fuel (suffixWordOf e g) zeroExps valid_zeroExps
        (WordAtomsLt8_suffixWordOf e g)) g
  | true =>
    show ValidExps (collectWord fuel e (invAtomWord g))
    exact collectWord_valid fuel (invAtomWord g) e hvalid
      (WordAtomsLt8_invAtomWord ha)

/-- Fuel independence: collecting with `fuel` and with `fuel + 1` agree
once the fuel is at least the word bound. -/
theorem collectWord_succ :
    ∀ (fuel : Nat) (w : List (Nat × Bool)) (e : List Nat),
      ValidExps e → WordAtomsLt8 w → wordBound w ≤ fuel →
        collectWord fuel e w = collectWord (fuel + 1) e w := by
  intro fuel
  induction fuel with
  | zero =>
    intro w e hvalid hats hb
    cases w with
    | nil => rfl
    | cons a as =>
      exfalso
      rw [wordBound_cons] at hb
      omega
  | succ fuel ih =>
    intro w e hvalid hats hb
    cases w with
    | nil => rfl
    | cons a as =>
      have hstep : ∀ (f : Nat) (e' : List Nat),
          collectWord (f + 1) e' (a :: as) =
            collectWord f (insertAtom (collectWord f) e' a) as := fun _ _ => rfl
      rw [hstep fuel, hstep (fuel + 1)]
      have hbound_as : wordBound as ≤ fuel := by
        rw [wordBound_cons] at hb
        omega
      have hbound_a : atomBound a ≤ fuel := by
        rw [wordBound_cons] at hb
        omega
      have hinsert : insertAtom (collectWord fuel) e a =
          insertAtom (collectWord (fuel + 1)) e a := by
        obtain ⟨g, inv⟩ := a
        have hg : g < 8 := hats (g, inv) (by simp)
        cases inv with
        | false =>
          show insertOne (collectWord fuel) e g =
            insertOne (collectWord (fuel + 1)) e g
          rw [insertOne_eq, insertOne_eq]
          congr 1
          refine ih (suffixWordOf e g) zeroExps valid_zeroExps
            (WordAtomsLt8_suffixWordOf e g) ?_
          have hsb := wordBound_suffixWordOf hvalid g
          have hab : atomBound (g, false) = stepsAtom g := rfl
          omega
        | true =>
          show collectWord fuel e (invAtomWord g) =
            collectWord (fuel + 1) e (invAtomWord g)
          exact ih (invAtomWord g) e hvalid (WordAtomsLt8_invAtomWord hg) (by
            have hb2 := wordBound_invAtomWord hg
            omega)
      rw [hinsert]
      exact ih as (insertAtom (collectWord (fuel + 1)) e a)
        (valid_insertAtom (fuel + 1) e a hvalid (hats a (by simp)))
        (fun a' ha' => hats a' (by simp [ha'])) hbound_as

/-- Fuel can be raised arbitrarily above the word bound. -/
theorem collectWord_fuel_eq {fuel₁ fuel₂ : Nat} (e : List Nat)
    (w : List (Nat × Bool)) (hvalid : ValidExps e) (hats : WordAtomsLt8 w)
    (h1 : wordBound w ≤ fuel₁) (h2 : wordBound w ≤ fuel₂) :
    collectWord fuel₁ e w = collectWord fuel₂ e w := by
  have key : ∀ (k : Nat) (fuel : Nat), wordBound w ≤ fuel →
      collectWord (fuel + k) e w = collectWord fuel e w := by
    intro k
    induction k with
    | zero => intro fuel _; simp
    | succ k ih =>
      intro fuel hf
      show collectWord (fuel + (k + 1)) e w = collectWord fuel e w
      rw [show fuel + (k + 1) = (fuel + 1) + k from by omega]
      exact (ih (fuel + 1) (by omega)).trans (collectWord_succ fuel w e hvalid hats hf).symm
  rcases le_total fuel₁ fuel₂ with hle | hle
  · have heq : fuel₂ = fuel₁ + (fuel₂ - fuel₁) := by omega
    rw [heq]
    exact (key (fuel₂ - fuel₁) fuel₁ h1).symm
  · have heq : fuel₁ = fuel₂ + (fuel₁ - fuel₂) := by omega
    rw [heq]
    exact key (fuel₁ - fuel₂) fuel₂ h2

/-- Append lemma: collecting a concatenated word is collecting the two
parts in succession (at any fuel above the bound of the concatenation). -/
theorem collectWord_append {F : Nat} (e : List Nat)
    (w₁ w₂ : List (Nat × Bool)) (hvalid : ValidExps e)
    (hats₁ : WordAtomsLt8 w₁) (hats₂ : WordAtomsLt8 w₂)
    (hF : wordBound (w₁ ++ w₂) ≤ F) :
    collectWord F e (w₁ ++ w₂) =
      collectWord F (collectWord F e w₁) w₂ := by
  induction w₁ generalizing e F with
  | nil =>
    have h0 : collectWord F e [] = e := by cases F <;> rfl
    simp [h0]
  | cons a as ih =>
    have hF' : wordBound (as ++ w₂) ≤ F - 1 := by
      have happ : wordBound (as ++ w₂) = wordBound as + wordBound w₂ :=
        wordBound_append as w₂
      rw [wordBound_append, wordBound_cons] at hF
      omega
    have hstep : ∀ (f : Nat) (e' : List Nat),
        collectWord (f + 1) e' (a :: (as ++ w₂)) =
          collectWord f (insertAtom (collectWord f) e' a) (as ++ w₂) :=
      fun _ _ => rfl
    obtain ⟨F', rfl⟩ : ∃ F', F = F' + 1 := ⟨F - 1, by
      have h1 : 1 ≤ wordBound ((a :: as) ++ w₂) := by
        rw [wordBound_append, wordBound_cons]; omega
      omega⟩
    have hstep2 : ∀ (f : Nat) (e' : List Nat),
        collectWord (f + 1) e' (a :: as) =
          collectWord f (insertAtom (collectWord f) e' a) as := fun _ _ => rfl
    rw [List.cons_append, hstep F']
    have hvalid_insert : ValidExps (insertAtom (collectWord F') e a) :=
      valid_insertAtom F' e a hvalid (hats₁ a (by simp))
    have hats_as : WordAtomsLt8 as := fun a' ha' => hats₁ a' (by simp [ha'])
    rw [ih (F := F') (e := insertAtom (collectWord F') e a) hvalid_insert hats_as hF', hstep2 F']
    rw [collectWord_fuel_eq (fuel₁ := F') (fuel₂ := F' + 1)
      (collectWord F' (insertAtom (collectWord F') e a) as) w₂
      (collectWord_valid F' as (insertAtom (collectWord F') e a) hvalid_insert hats_as) hats₂
      (by have happ : wordBound (as ++ w₂) = wordBound as + wordBound w₂ :=
            wordBound_append as w₂; omega)
      (by have happ : wordBound (as ++ w₂) = wordBound as + wordBound w₂ :=
            wordBound_append as w₂; omega)]

theorem valid_decodeExps (n : Nat) (hn : n < 384) : ValidExps (decodeExps n) := by
  refine ⟨by rfl, fun k hk => ?_⟩
  interval_cases k
  · show n % 3 < 3; exact Nat.mod_lt _ (by norm_num)
  · show (n / 3) % 2 < 2; exact Nat.mod_lt _ (by norm_num)
  · show ((n / 3) / 2) % 2 < 2; exact Nat.mod_lt _ (by norm_num)
  · show (((n / 3) / 2) / 2) % 2 < 2; exact Nat.mod_lt _ (by norm_num)
  · show ((((n / 3) / 2) / 2) / 2) % 2 < 2; exact Nat.mod_lt _ (by norm_num)
  · show (((((n / 3) / 2) / 2) / 2) / 2) % 2 < 2; exact Nat.mod_lt _ (by norm_num)
  · show ((((((n / 3) / 2) / 2) / 2) / 2) / 2) % 2 < 2; exact Nat.mod_lt _ (by norm_num)
  · show ((((((n / 3) / 2) / 2) / 2) / 2) / 2) / 2 < 2; omega

theorem encodeExps_lt {e : List Nat} (hvalid : ValidExps e) :
    encodeExps e < 384 := by
  have h0 : getExp e 0 < 3 := by
    have h := hvalid.2 0 (by norm_num)
    rwa [show pcRange 0 = 3 from rfl] at h
  have h1 : getExp e 1 < 2 := by
    have h := hvalid.2 1 (by norm_num)
    rwa [show pcRange 1 = 2 from rfl] at h
  have h2 : getExp e 2 < 2 := by
    have h := hvalid.2 2 (by norm_num)
    rwa [show pcRange 2 = 2 from rfl] at h
  have h3 : getExp e 3 < 2 := by
    have h := hvalid.2 3 (by norm_num)
    rwa [show pcRange 3 = 2 from rfl] at h
  have h4 : getExp e 4 < 2 := by
    have h := hvalid.2 4 (by norm_num)
    rwa [show pcRange 4 = 2 from rfl] at h
  have h5 : getExp e 5 < 2 := by
    have h := hvalid.2 5 (by norm_num)
    rwa [show pcRange 5 = 2 from rfl] at h
  have h6 : getExp e 6 < 2 := by
    have h := hvalid.2 6 (by norm_num)
    rwa [show pcRange 6 = 2 from rfl] at h
  have h7 : getExp e 7 < 2 := by
    have h := hvalid.2 7 (by norm_num)
    rwa [show pcRange 7 = 2 from rfl] at h
  show getExp e 0 + 3 * (getExp e 1 + 2 * (getExp e 2 + 2 * (getExp e 3 +
    2 * (getExp e 4 + 2 * (getExp e 5 + 2 * (getExp e 6 + 2 * getExp e 7)))))) < 384
  omega

theorem decode_encode {e : List Nat} (hvalid : ValidExps e) :
    decodeExps (encodeExps e) = e := by
  obtain ⟨a, b, c, d, f, g, h, ii, rfl⟩ :
      ∃ a b c d f g h i, e = [a, b, c, d, f, g, h, i] := by
    rcases e with _ | ⟨a, e⟩
    · exact absurd hvalid.1 (by simp)
    rcases e with _ | ⟨b, e⟩
    · exact absurd hvalid.1 (by simp)
    rcases e with _ | ⟨c, e⟩
    · exact absurd hvalid.1 (by simp)
    rcases e with _ | ⟨d, e⟩
    · exact absurd hvalid.1 (by simp)
    rcases e with _ | ⟨f, e⟩
    · exact absurd hvalid.1 (by simp)
    rcases e with _ | ⟨g, e⟩
    · exact absurd hvalid.1 (by simp)
    rcases e with _ | ⟨h, e⟩
    · exact absurd hvalid.1 (by simp)
    rcases e with _ | ⟨ii, e⟩
    · exact absurd hvalid.1 (by simp)
    refine ⟨a, b, c, d, f, g, h, ii, ?_⟩
    cases e with
    | nil => rfl
    | cons _ _ =>
      exfalso
      have hlen := hvalid.1
      simp only [ValidExps, List.length_cons] at hlen
      omega
  have ha : a < 3 := by
    have h := hvalid.2 0 (by norm_num)
    exact h
  have hb : b < 2 := by
    have h := hvalid.2 1 (by norm_num)
    exact h
  have hc : c < 2 := by
    have h := hvalid.2 2 (by norm_num)
    exact h
  have hd : d < 2 := by
    have h := hvalid.2 3 (by norm_num)
    exact h
  have hf : f < 2 := by
    have h := hvalid.2 4 (by norm_num)
    exact h
  have hg : g < 2 := by
    have h := hvalid.2 5 (by norm_num)
    exact h
  have hh : h < 2 := by
    have h := hvalid.2 6 (by norm_num)
    exact h
  have hii : ii < 2 := by
    have h := hvalid.2 7 (by norm_num)
    exact h
  apply List.ext_getElem
  · rfl
  · intro i hi
    have hi8 : i < 8 := by
      rw [show (decodeExps (encodeExps [a, b, c, d, f, g, h, ii])).length = 8 by rfl] at hi
      exact hi
    interval_cases i
    · intro _; show (a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) % 3 = a
      omega
    · intro _; show ((a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) / 3) % 2 = b
      omega
    · intro _; show (((a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) / 3) / 2) % 2 = c
      omega
    · intro _; show ((((a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) / 3) / 2) / 2) % 2 = d
      omega
    · intro _; show (((((a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) / 3) / 2) / 2) / 2) % 2 = f
      omega
    · intro _; show ((((((a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) / 3) / 2) / 2) / 2) / 2) % 2 = g
      omega
    · intro _; show (((((((a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) / 3) / 2) / 2) / 2) / 2) / 2) % 2 = h
      omega
    · intro _; show (((((((a + 3 * (b + 2 * (c + 2 * (d + 2 * (f + 2 * (g + 2 * (h + 2 * ii))))))) / 3) / 2) / 2) / 2) / 2) / 2) / 2 = ii
      omega

theorem actWord_append (w₁ w₂ : List (Nat × Bool)) (x : Fin 384)
    (hats₁ : WordAtomsLt8 w₁) (hats₂ : WordAtomsLt8 w₂)
    (hF : wordBound (w₁ ++ w₂) ≤ 10000) :
    actWord (w₁ ++ w₂) x = actWord w₂ (actWord w₁ x) := by
  have hvalid₁ : ValidExps (collectWord 10000 (decodeExps x.1) w₁) :=
    collectWord_valid 10000 w₁ (decodeExps x.1) (valid_decodeExps x.1 x.2) hats₁
  have hdec : decodeExps (actWord w₁ x).1 = collectWord 10000 (decodeExps x.1) w₁ := by
    have h1 : (actWord w₁ x).1 =
        encodeExps (collectWord 10000 (decodeExps x.1) w₁) % 384 := rfl
    rw [h1, Nat.mod_eq_of_lt (encodeExps_lt hvalid₁)]
    exact decode_encode hvalid₁
  apply Fin.ext
  show encodeExps (collectWord 10000 (decodeExps x.1) (w₁ ++ w₂)) % 384 =
    encodeExps (collectWord 10000 (decodeExps (actWord w₁ x).1) w₂) % 384
  rw [hdec]
  rw [collectWord_append (decodeExps x.1) w₁ w₂ (valid_decodeExps x.1 x.2) hats₁ hats₂ hF]

end SemiabelianNonMonomial
